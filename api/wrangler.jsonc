{
	"$schema": "../node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-01-08",
	"compatibility_flags": ["nodejs_compat"],
	"name": "bettaresume-api-server",
	"main": "./src/server.ts",
	"workers_dev": false,
	"route": {
		"pattern": "$CF_WORKER_CUSTOM_URL",
		"custom_domain": true
	},
	"d1_databases": [
		{
			"binding": "bettaresume_d1",
			"database_name": "bettaresume",
			"database_id": "$D1_DATABASE_ID",
			"migrations_dir": "./drizzle"
		}
	],
	"vars": {
		"CLERK_PUBLISHABLE_KEY": "$CLERK_PUBLISHABLE_KEY",
		// Production. Explicitly NOT "development", so the x-dev-mode auth bypass in
		// src/trpc/context.ts stays off even if a request sets the header.
		"ENVIRONMENT": "production"
	},
	"dev": {
		"port": 4000
	}
}
