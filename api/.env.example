# @clerk/fastify
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Wrangler config (referred to in wrangler.jsonc)
CF_WORKER_CUSTOM_URL=api.example.com
D1_DATABASE_NAME=bettaresume
D1_DATABASE_ID=

# Allowed CORS origin (restrict in production, defaults to * if unset)
ALLOWED_ORIGIN=http://localhost:3000

# Worker ENVIRONMENT binding. The x-dev-mode auth bypass in src/trpc/context.ts
# activates ONLY when this is exactly "development"; any other value (including
# unset) leaves it off. Set "development" only in api/wrangler.dev.jsonc.
# Production (api/wrangler.jsonc) must not use "development".
# ENVIRONMENT=development

# set to ./src/db/db.sqlite if developing locally, leave empty otherwise
LOCAL_DB_PATH=./src/db/db.sqlite
