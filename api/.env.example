# @clerk/fastify
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Wrangler config (referred to in wrangler.jsonc)
CF_WORKER_CUSTOM_URL=api.example.com
D1_DATABASE_NAME=bettaresume
D1_DATABASE_ID=

# CORS allow-list, read by api/src/cors.ts. Comma-separated list of EXACT
# browser origins, e.g. "https://bettaresume.com,https://www.bettaresume.com".
#
# DEFAULT-DENY: if this is unset or empty, EVERY origin is refused — it does
# NOT fall back to "*". A browser on an origin that is not listed here will see
# every API call blocked, so this must be set for the deployed site to work.
#
# LOCAL DEV ONLY. Production reads the committed list at api/allowed-origins.txt,
# so nothing has to be configured in repository settings. The value there must be a
# bare origin (`scheme://host[:port]`, no trailing slash, no path) — it is matched
# exactly against the browser's Origin header.
#
# An entry of "*" is honoured as "allow any origin" for local tooling, but it is
# not the default and should not be used in production. Note that the old name
# for this variable was ALLOWED_ORIGIN (singular) and it was never read by any
# code — a wildcard was hardcoded instead.
# Must include the scheme. A bare host like `app.bettaresume.com` can never match a
# browser Origin header, so every API call from the page is blocked -- the same failure
# mode that took production down in #146. Local frontend runs on :3000 (see CLAUDE.md).
ALLOWED_ORIGINS=http://localhost:3000

# Worker ENVIRONMENT binding. The x-dev-mode auth bypass in src/trpc/context.ts
# activates ONLY when this is exactly "development"; any other value (including
# unset) leaves it off. Set "development" only in api/wrangler.dev.jsonc.
# Production (api/wrangler.jsonc) must not use "development".
# ENVIRONMENT=development

# set to ./src/db/db.sqlite if developing locally, leave empty otherwise
LOCAL_DB_PATH=./src/db/db.sqlite
