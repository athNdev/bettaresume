{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"root": true,
	"vcs": {
		"enabled": true,
		"useIgnoreFile": true,
		"clientKind": "git"
	},
	"files": {
		"ignoreUnknown": true,
		// The browser harness under `scripts/probe/` is developer tooling: CommonJS, run by
		// hand against a local server, never shipped. Linting it as application code would
		// spend the ratchet's budget on `require` and `console`.
		"includes": [
			"**",
			"!node_modules",
			"!generated",
			"!scripts/probe",
			"!scripts/probe-start.cjs",
			// Generated by `wrangler types` from the Worker's bindings. Editing it is not
			// possible and linting it spent more than half of this repo's entire findings
			// budget on declarations that are regenerated on every `wrangler dev`.
			"!api/worker-configuration.d.ts"
		]
	},
	"assist": {
		"enabled": true,
		"actions": {
			"recommended": true,
			"source": {
				"recommended": true,
				"organizeImports": "on",
				"useSortedAttributes": "on"
			}
		}
	},
	"formatter": {
		"enabled": true
	},
	"linter": {
		"enabled": true,
		"rules": {
			// Biome 2.4 renamed `recommended` to `preset`; the old key still works but
			// warns on every run. This is the same set of rules.
			"preset": "recommended",
			"nursery": {
				"useSortedClasses": {
					"level": "warn",
					"fix": "safe",
					"options": {
						"functions": ["clsx", "cva", "cn"]
					}
				}
			}
		}
	},
	"html": {
		"formatter": {
			"enabled": true
		}
	},
	"javascript": {
		"assist": {
			"enabled": true
		},
		"formatter": {
			"enabled": true
		},
		"linter": {
			"enabled": true
		}
	},
	"css": {
		"assist": {
			"enabled": true
		},
		"formatter": {
			"enabled": true
		},
		"linter": {
			"enabled": true
		},
		"parser": {
			"cssModules": true,
			"tailwindDirectives": true
		}
	}
}
